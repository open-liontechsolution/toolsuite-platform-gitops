# Plaintext inputs for the Authentik sealed secrets (environment: casa).
#
# 1) Copy this file:   cp scripts/authentik-secrets.env.example scripts/authentik-secrets.env
# 2) Fill the values below (scripts/authentik-secrets.env is git-ignored).
# 3) Run:              ./scripts/seal-authentik.sh
#
# The script seals each value with kubeseal and writes the ciphertext into:
#   apps/data/authentik-postgres/environments/local/casa.yaml   (ns data-casa)
#   apps/security/authentik/environments/local/casa.yaml        (ns security-casa)

# --- Database (shared between the CNPG cluster and Authentik) ---
AUTHENTIK_DB_USERNAME=authentik
AUTHENTIK_DB_PASSWORD=          # REQUIRED: choose a strong password

# --- Authentik runtime ---
# Leave SECRET_KEY / BOOTSTRAP_TOKEN empty to auto-generate them.
AUTHENTIK_SECRET_KEY=           # optional: empty -> openssl rand -base64 60
AUTHENTIK_BOOTSTRAP_PASSWORD=   # REQUIRED: initial akadmin password
AUTHENTIK_BOOTSTRAP_TOKEN=      # optional: empty -> openssl rand -hex 32
